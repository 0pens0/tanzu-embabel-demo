package com.embabel.demo;

import org.springframework.boot.SpringApplication;
import org.springframework.boot.autoconfigure.SpringBootApplication;

/**
 * Main application class for the Tanzu Embabel Demo.
 * 
 * This application demonstrates the Embabel AI agent framework with:
 * - A TaskBreakdownAgent that shows @Agent, @Action, and @AchievesGoal annotations
 * - REST API endpoints to interact with the agent
 * - Educational web frontend explaining the framework
 * - Cloud Foundry deployment configuration
 */
@SpringBootApplication
public class TanzuEmbabelDemoApplication {

    public static void main(String[] args) {
        SpringApplication.run(TanzuEmbabelDemoApplication.class, args);
    }
}